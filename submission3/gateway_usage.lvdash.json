{
  "datasets": [
    {
      "name": "ds_gateway_usage",
      "displayName": "Gateway usage (app + agent + MCP)",
      "queryLines": [
        "SELECT source, endpoint, decision, request_ts,\n",
        "       COALESCE(actual_cost_usd, est_cost_usd, 0) AS cost_usd,\n",
        "       CASE WHEN decision LIKE '%block%' THEN 1 ELSE 0 END AS blocked\n",
        "FROM (\n",
        "  SELECT source, endpoint, decision, request_ts, actual_cost_usd, est_cost_usd FROM rkm_sandbox_1_catalog.demo_workshop_northpeak_retail_stockout_markdown_rescue.app_inference_table\n",
        "  UNION ALL\n",
        "  SELECT source, endpoint, decision, request_ts, actual_cost_usd, est_cost_usd FROM rkm_sandbox_1_catalog.demo_workshop_northpeak_retail_stockout_markdown_rescue.agent_inference_table\n",
        ")\n"
      ]
    }
  ],
  "pages": [
    {
      "name": "usage",
      "displayName": "AI Gateway Usage & Budgets",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": 2,
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "# NorthPeak \u2014 Unity Gateway: Usage & Budgets\nBounded, visible, attributable AI spend across the app, the coding agent, and the MCP."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "c_calls",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_gateway_usage",
                  "fields": [
                    {
                      "name": "total_calls",
                      "expression": "COUNT(`request_ts`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "total_calls",
                  "displayName": "Total governed calls",
                  "format": {
                    "type": "number",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 0
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Total governed calls"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "c_cost",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_gateway_usage",
                  "fields": [
                    {
                      "name": "total_cost",
                      "expression": "SUM(`cost_usd`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "total_cost",
                  "displayName": "Total AI spend ($)",
                  "format": {
                    "type": "number-currency",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 4
                    },
                    "currencyCode": "USD"
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Total AI spend ($)"
              }
            }
          },
          "position": {
            "x": 3,
            "y": 2,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
